{
  "info": {
    "name": "Hiring Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete API collection for the franchise hiring platform. Import this file and set the environment variables listed below."
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "token", "value": "", "type": "string", "description": "Bearer token from POST /auth/login" },
    { "key": "store_id", "value": "main-street", "type": "string", "description": "store_name of the target store" },
    { "key": "workflow_id", "value": "1", "type": "string" },
    { "key": "stage_id", "value": "1", "type": "string" },
    { "key": "transition_id", "value": "1", "type": "string" },
    { "key": "questionnaire_id", "value": "1", "type": "string" },
    { "key": "question_id", "value": "1", "type": "string" },
    { "key": "job_opening_id", "value": "1", "type": "string" },
    { "key": "application_id", "value": "1", "type": "string" },
    { "key": "document_template_id", "value": "1", "type": "string" },
    { "key": "requirement_id", "value": "1", "type": "string" },
    { "key": "document_id", "value": "1", "type": "string" },
    { "key": "automation_rule_id", "value": "1", "type": "string" },
    { "key": "user_id", "value": "1", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/health", "host": ["{{base_url}}"], "path": ["api", "v1", "health"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().data.token); }"], "type": "text/javascript" } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}" }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{base_url}}/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/users?per_page=20", "host": ["{{base_url}}"], "path": ["api", "v1", "users"], "query": [{ "key": "per_page", "value": "20" }, { "key": "search", "value": "", "disabled": true }, { "key": "role", "value": "", "disabled": true }, { "key": "status", "value": "", "disabled": true }] }
          }
        },
        {
          "name": "Get User",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/users/{{user_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "users", "{{user_id}}"] }
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/v1/users", "host": ["{{base_url}}"], "path": ["api", "v1", "users"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"store_manager\",\n  \"access_scope\": \"store\",\n  \"store_ids\": [1]\n}" }
          }
        }
      ]
    },
